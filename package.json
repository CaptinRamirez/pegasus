{
  "name": "pegasus",
  "private": true,
  "version": "0.1.0",
  "description": "Single-user crypto perpetual swap trading terminal for OKX: React web front end + Fastify back end",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @pegasus/api dev",
    "dev:web": "pnpm --filter @pegasus/web dev",
    "dev:mock": "pnpm --filter @pegasus/mock-okx dev",
    "dev:paper": "pnpm --filter @pegasus/paper dev",
    "backtest": "pnpm --filter @pegasus/backtest start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @pegasus/api db:generate",
    "db:migrate": "pnpm --filter @pegasus/api db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
