# ---- OKX credentials (create at https://www.okx.com/account/my-api, enable Trade permission) ----
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# 1 = demo trading (paper money on OKX), 0 = live. Start with 1.
OKX_DEMO=1
# Optional endpoint overrides (defaults are OKX production/demo hosts; set to the mock server for offline dev)
# OKX_REST_URL=http://127.0.0.1:9100
# OKX_WS_PUBLIC_URL=ws://127.0.0.1:9100/ws/v5/public
# OKX_WS_PRIVATE_URL=ws://127.0.0.1:9100/ws/v5/private
# OKX_WS_BUSINESS_URL=ws://127.0.0.1:9100/ws/v5/business

# ---- API server ----
API_HOST=127.0.0.1
API_PORT=8787
# Shared secret the web app must present (Authorization: Bearer ...). Generate with: openssl rand -hex 32
API_TOKEN=change-me
# Comma separated list of instruments to track at startup
INSTRUMENTS=BTC-USDT-SWAP,ETH-USDT-SWAP
# Default trade mode for new orders: cross | isolated
DEFAULT_TD_MODE=cross
LOG_LEVEL=info

# ---- Persistence (optional; when unset the API keeps state in memory only) ----
# DATABASE_URL=postgres://pegasus:pegasus@127.0.0.1:5432/pegasus

# ---- Risk limits (USD notional unless stated) ----
RISK_MAX_ORDER_NOTIONAL=5000
RISK_MAX_POSITION_NOTIONAL_PER_INSTRUMENT=20000
RISK_MAX_TOTAL_POSITION_NOTIONAL=50000
RISK_MAX_LEVERAGE=10
RISK_DAILY_LOSS_LIMIT=1000
RISK_MAX_OPEN_ORDERS=20
# Limit orders further than this fraction from mark price are rejected (0.05 = 5%)
RISK_PRICE_BAND_PCT=0.05
# Market orders whose estimated slippage against the book exceeds this fraction are rejected
RISK_MAX_SLIPPAGE_PCT=0.005
