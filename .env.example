# ---- OKX credentials (create at https://www.okx.com/account/my-api, enable Trade permission) ----
# Set all three, or leave all three empty for market data only; one or two of them is refused at start-up.
# A read-only key works too: the terminal then shows the account but refuses to send orders.
# A value containing # must be wrapped in double quotes, e.g. OKX_API_PASSPHRASE="abc#123":
# without the quotes everything from the # on is dropped and the passphrase is silently cut short.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# 1 = demo trading (paper money on OKX), 0 = live. Start with 1.
OKX_DEMO=1
# Leave at 0: orders and cancels go over REST. 1 (the private WebSocket) is refused at start-up, because OKX
# deprecated the instId parameter of its WebSocket order operations and Pegasus is not migrated to instIdCode.
OKX_WS_TRADING=0
# Optional endpoint overrides (defaults are the OKX production/demo hosts). Set all four or none; a subset is
# refused at start-up. For the local mock exchange you do not need them: start with `pnpm start --mock`
# (or `start.bat --mock`), which sets them for that run only and leaves this file alone.
# OKX_REST_URL=http://127.0.0.1:9100
# OKX_WS_PUBLIC_URL=ws://127.0.0.1:9100/ws/v5/public
# OKX_WS_PRIVATE_URL=ws://127.0.0.1:9100/ws/v5/private
# OKX_WS_BUSINESS_URL=ws://127.0.0.1:9100/ws/v5/business

# ---- Paper trading (optional) ----
# OKX live market data, a simulated account kept on this machine; nothing is sent to an OKX account and no API
# key is needed. Start it with `pnpm start --paper` (or start-paper.bat), or set PAPER_TRADING=1 to make it what
# `pnpm start` / start.bat do. A key above is not used in this mode.
# PAPER_TRADING=1
# USDT a NEW paper account starts with; an existing one keeps its balance (delete data/paper-account.json to start over).
# PAPER_BALANCE=100000
# Leverage of an instrument until it is set in the ticket.
# PAPER_LEVERAGE=3
# PAPER_TAKER_FEE=0.0005
# PAPER_MAKER_FEE=0.0002
# net_mode (default) or long_short_mode; cannot be changed once the account exists.
# PAPER_POS_MODE=net_mode
# PAPER_STATE_FILE=data/paper-account.json
# PAPER_PORT=9200

# ---- Campaign (paper trading only) ----
# The campaign rule (packages/shared/src/campaign.ts): 10x isolated longs on a small pot. The simplest way to run it
# is `pnpm start --campaign` (or start-campaign.bat): paper trading on the pot's own paper account,
# data/paper-campaign.json (a new one opens with CAMPAIGN_POT_START, 56 by default), with the campaign enabled, its
# ledger in data/campaign-ledger.json and the kill switch in data/pegasus-state.campaign.json. Those four win over
# this file for that run; your own paper account (data/paper-account.json) is not touched. It cannot be combined
# with --mock. The settings below that it does not set (the instruments, the start, the minimum stake, the
# structure) are read from here.
# 1 enables it by hand, and only in paper trading: with CAMPAIGN_ENABLED=1 the API refuses to start unless it runs
# against the paper exchange (pnpm start --paper, or PAPER_TRADING=1 above). This stage is paper only.
# CAMPAIGN_ENABLED=0
# USDT swaps the campaigns run on (default: the ten below, CAMPAIGN_INSTRUMENTS in @pegasus/shared); while enabled
# their markets are tracked beside INSTRUMENTS and the paper exchange trades them, but the SIGNALS tab and
# /api/signals stay on INSTRUMENTS.
# CAMPAIGN_INSTRUMENTS=BTC-USDT-SWAP,ETH-USDT-SWAP,LTC-USDT-SWAP,XRP-USDT-SWAP,BCH-USDT-SWAP,ETC-USDT-SWAP,LINK-USDT-SWAP,ADA-USDT-SWAP,DOT-USDT-SWAP,TRX-USDT-SWAP
# What the pot starts with and the smallest stake, USDT.
# CAMPAIGN_POT_START=56
# CAMPAIGN_MIN_STAKE=5.6
# pyramid (a campaign that works adds to itself out of its open profit) or noadd.
# CAMPAIGN_STRUCTURE=pyramid
# The pot needs a paper account of its own: it starts only on an account whose equity is CAMPAIGN_POT_START (within
# 1%) and that holds no position or order. --campaign gives it one; by hand, run the paper exchange on a new account
# for it, e.g. PAPER_STATE_FILE=data/paper-campaign.json with PAPER_BALANCE=56. Otherwise the campaign stays blocked
# (GET /api/campaign says why) and the rest of the terminal works as usual.
# The campaign's ledger (the pot, its campaigns, the bankings, the decision log, the execution errors), written after
# every change and read at start; a relative path is taken from the project folder. It belongs to the paper account
# the pot runs on: give a new paper account a new ledger file. A damaged file is never written over: the campaign
# then stays blocked until it is repaired or moved away.
# CAMPAIGN_STATE_FILE=data/campaign-ledger.json
# Beside the pot the API replays the rule from the pot's start on OKX's bars (GET /api/campaign/replay): nothing to
# set. What it reads from OKX is kept in data/campaign-replay. `pnpm backtest:campaign --reconcile <ledger file>`
# prints the same from the command line.
# `pnpm start --campaign` runs on ports of its own, so that it can run beside `pnpm start` or `pnpm start --paper`:
# API 8788, paper exchange 9201, page 5175 (API_PORT and PAPER_PORT below are the other stack's). It also keeps its
# own log files (logs/campaign) and trade journal (data/journal.campaign.json). To move its ports:
# CAMPAIGN_API_PORT=8788
# CAMPAIGN_PAPER_PORT=9201
# CAMPAIGN_WEB_PORT=5175

# ---- API server ----
API_HOST=127.0.0.1
API_PORT=8787
# Shared secret the web app must present (Authorization: Bearer ...). Generate with: openssl rand -hex 32
API_TOKEN=change-me
# Web pages allowed to call the API, as exact origins (comma separated). Requests whose Origin header is
# anything else are refused. Change this only when the terminal page is served from another address or port.
WEB_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Comma separated list of instruments to track at startup
INSTRUMENTS=BTC-USDT-SWAP,ETH-USDT-SWAP
# Default trade mode for new orders: cross | isolated
DEFAULT_TD_MODE=cross
LOG_LEVEL=info
# Directory of the log files (pegasus-YYYY-MM-DD.log, one per local day, the newest 14 are kept). The same
# lines the console shows, as JSON. A relative path is taken from the project folder.
# LOG_DIR=logs

# ---- Persistence ----
# Without a database the order history is kept in memory only, but the kill switch and the day's equity baseline
# are saved to this file, so a halt and the daily loss so far survive closing and reopening the terminal.
# A relative path is taken from the project folder. If the file is damaged the API starts with the kill switch ON.
# STATE_FILE=data/pegasus-state.json
# Channel trailing (paper trading and the local mock only): the positions whose stop the API keeps at the channel of
# the last daily bars, and the trailing exits waiting for their order to fill. Default: next to STATE_FILE, named
# after it (data/pegasus-state.paper.json gives data/pegasus-state.paper.trailing.json), so each account keeps its own.
# TRAILING_STATE_FILE=
# Optional database; when set it holds the order history and the risk state, and STATE_FILE is not used.
# DATABASE_URL=postgres://pegasus:pegasus@127.0.0.1:5432/pegasus
# The trade journal: every trade of the account from flat to flat (its plan, fills, exits and reasons, P&L, R), kept
# in this file whichever store is used and read again at start, when the fills of the time the API was not running
# are read from the exchange. The launcher gives every account its own: data/journal.paper.json with --paper,
# data/journal.mock.json with --mock, data/journal.campaign.json with --campaign. A damaged file is never written
# over: the journal then records nothing until it is repaired or moved away (a copy is kept as <file>.corrupt).
# JOURNAL_FILE=data/journal.json

# ---- Signals ----
# Daily cuts the SIGNALS tab computes, UTC hours: 0, 12 or both. Each cut is sized at 1/n of a unit, so with
# both an instrument is entered in two half-size lots (one per cut, each with its own stop). One cut means one
# look a day and one lot; the expected return is the same, only the luck of which cut you picked is not averaged.
SIGNAL_PHASES=0,12

# ---- Risk limits (USD notional unless stated) ----
RISK_MAX_ORDER_NOTIONAL=5000
RISK_MAX_POSITION_NOTIONAL_PER_INSTRUMENT=20000
RISK_MAX_TOTAL_POSITION_NOTIONAL=50000
RISK_MAX_LEVERAGE=10
RISK_DAILY_LOSS_LIMIT=1000
RISK_MAX_OPEN_ORDERS=20
# Limit orders further than this fraction from mark price are rejected (0.05 = 5%). A fraction: 1 or more is refused.
RISK_PRICE_BAND_PCT=0.05
# Market orders whose estimated slippage against the book exceeds this fraction are rejected (0.005 = 0.5%; below 1)
RISK_MAX_SLIPPAGE_PCT=0.005
